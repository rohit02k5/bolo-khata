# copy to .env — never commit the real file
GNANI_API_KEY=your_key_here

# prisma-v3.0 (auto lang detect, code-mix) or prisma-v2.5 (proven)
STT_MODEL=prisma-v3.0
STT_FORMAT=transcribe
TTS_MODEL=timbre-v2.5

# seeded owner login (no magic links)
OWNER_EMAIL=owner@bolokhata.demo
OWNER_PASSWORD=change-me
SESSION_SECRET=change-me-too

# shop + UPI (self-reported, synthetic in demo)
SHOP_NAME=Sharma Kirana Store
SHOP_VPA=bolokhata-demo@upi
CONFIRM_AMOUNT_PAISE=50000

DB_PATH=data/bolo.db
CORS_ORIGINS=http://localhost:3000
# MOCK_GNANI=1   # force mock STT/TTS for offline dev

# OAuth owner sign-in (optional — buttons hide until configured)
# Google: https://console.cloud.google.com -> Credentials -> OAuth client (Web)
#   authorized redirect URI: http://localhost:8000/api/auth/google/callback
# Discord: https://discord.com/developers -> OAuth2 -> redirect:
#   http://localhost:8000/api/auth/discord/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# OAUTH_REDIRECT_BASE=   # override if API public host differs from request host
